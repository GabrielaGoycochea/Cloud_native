{
  "info": {
    "name": "Eventos Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventoId",
      "value": "1"
    },
    {
      "key": "numeroResumen",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Listar eventos disponibles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/eventos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var eventos = pm.response.json();",
              "if (eventos.length > 0) {",
              "  pm.collectionVariables.set('eventoId', eventos[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Agregar evento (Concierto Rock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/eventos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Concierto Rock\",\n  \"fecha\": \"2026-12-15\",\n  \"precio\": 25000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Agregar evento (Festival Jazz)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/eventos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Festival de Jazz\",\n  \"fecha\": \"2026-11-20\",\n  \"precio\": 18000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Listar eventos (elegir un id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/eventos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var eventos = pm.response.json();",
              "if (eventos.length > 0) {",
              "  pm.collectionVariables.set('eventoId', eventos[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Buscar evento por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/eventos/{{eventoId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos",
            "{{eventoId}}"
          ]
        }
      }
    },
    {
      "name": "6. Comprar entradas (evento elegido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/compras",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "compras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": {{eventoId}},\n  \"cantidad\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var json = pm.response.json();",
              "  if (json.numeroResumen) {",
              "    pm.collectionVariables.set('numeroResumen', json.numeroResumen);",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Generar archivo del resumen (descarga fisica)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}/archivo",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}",
            "archivo"
          ]
        }
      }
    },
    {
      "name": "8. Subir resumen a S3",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}/s3",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}",
            "s3"
          ]
        }
      }
    },
    {
      "name": "9. Descargar resumen desde S3",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}"
          ]
        }
      }
    },
    {
      "name": "10. Modificar resumen en S3",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "RESUMEN DE COMPRA Nro. {{numeroResumen}} (CORREGIDO)\nEvento: Concierto Rock\nEntradas: 3\nPrecio unitario: 25000.00\nPrecio total: 75000.00\n",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        }
      }
    },
    {
      "name": "11. Descargar resumen modificado desde S3",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}"
          ]
        }
      }
    },
    {
      "name": "12. Borrar resumen en S3",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}"
          ]
        }
      }
    },
    {
      "name": "13. Borrar resumen otra vez (valida 404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/resumenes/{{numeroResumen}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "resumenes",
            "{{numeroResumen}}"
          ]
        }
      }
    },
    {
      "name": "14. Eliminar evento (solo si no tiene compras)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/eventos/{{eventoId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "eventos",
            "{{eventoId}}"
          ]
        }
      }
    }
  ]
}